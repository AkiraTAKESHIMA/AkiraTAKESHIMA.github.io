## index
基本的な実装例
## index/
## contents
## src python
import numpy as np
import matplotlib.pyplot as plt
import matplotlib as mpl

# Make data for heatmap
nx, ny = 100, 100
x = np.cos(np.linspace(0, np.pi*8, nx))
y = np.sin(np.linspace(0, np.pi*8, ny))
xx, yy = np.meshgrid(x, y)
data = xx * yy

# Make data for line
lines = []
nLine = 5
for iLine in range(5):
    x = np.linspace(0, nx-1, 1000)
    y = np.sin(x) + ny*(iLine+0.5)/nLine
    v = iLine
    lines.append((x, y, v))

# Prepare ScalarMappable and colormap for line
sm_line = mpl.cm.ScalarMappable(norm=norm_line, cmap=cmap_line)
sm_line.set_array([])
cmap_line = plt.cm.coolwarm
norm_line = mpl.colors.Normalize(vmin=0, vmax=nLine-1)

# Plot
fig, ax = plt.subplots()

im_heat = ax.imshow(data, cmap=plt.cm.viridis, interpolation='nearest')

for (x, y, v) in lines:
    ax.plot(x, y, color=cmap_line(norm_line(v)))

# Colorbar of line
cbar_line = fig.colorbar(
    sm_line, ax=ax, aspect=40, pad=0.08, label='Line'
)

# Colorbar of heatmap
cbar_heat = fig.colorbar(
    im_heat, ax=ax, aspect=40, pad=0.04, label='Heatmap'
)

plt.show()
## src/

## img
url="${img}/auto_01.png"
## img/

　ポイントは
　・/w{Line plot}のカラーバーの描画には/s{ScalarMappable}を使う

　注意点は以下の/w{2}点。

　1. カラーバーは/b{後から描いたもの}が図の近くに配置される
　　順番を入れ替えるには描画順を変えるか、カラーバー用の軸を別途定義する（後述）。
　　/s{pad}の値を負の値にするなどして無理矢理変えることも可能ではあるが、調整が面倒でありスマートな方法ではない。

　2. /s{pad}の基準は、最も図に近いカラーバーの場合は図本体、それ以外は自分よりひとつ内側（図本体に近い側）のカラーバーである
　　この例で言うと、/s{cbar_heat}は図本体から/w{0.04}, /s{cbar_line}は/s{cbar_heat}から/w{0.08}の距離に配置される。もっと細かい話をすると、/s{cbar_line}が基準としているのは/s{cbar_heat}の軸ではなく、目盛ラベル (/w{0.00}とか/w{-0.75}とか) の右側となっているようである（推察）。だから例えば/s{cbar_line}で/s{pad=0}とすると下図のようになる。

