#===============================================================
## index
解説: 参照渡し
## index/
## contents
#---------------------------------------------------------------
/idx1{/wr{numpy}配列を/w{C}のポインタ配列として受け取る}
#---------------------------------------------------------------
　ソースコード内の順番とは前後するが、まずはベースとなる関数について。
## src c
double *getptr_to_pyarray_double(PyArrayObject *arrayin){
    double *c;

    if (PyArray_TYPE(arrayin) != NPY_DOUBLE) {
        PyErr_SetString(PyExc_TypeError, "Array must be of type float64 (double)");
        return NULL;
    }

    c = (double *)PyArray_DATA(arrayin);
    return c;
}
## src/

/b{PyArray_TYPE( PyArrayObject *obj )}
　/v{obj}のデータ型を取得する。今回は/w{8}バイト浮動小数点数 (/v{NPY_DOUBLE}) と想定しているので、そうでない場合はエラーを返す。

/b{PyArray_DATA( PyArrayObject *obj )}
　/v{obj}のデータ型を指示するポインタを取得する。

　この関数において変数/v{c}は変数/v{arrayin}と同じメモリ領域を参照している。これを戻り値として返す。

#---------------------------------------------------------------
/idx1{受け取った中身を操作する}
#---------------------------------------------------------------
## src c
void inc_array(PyArrayObject *arrayin, double inc){
    double *c;
    int m, n;

    printf("from inc_array\n");
    printf("dimensions: %d, type: %d\n", PyArray_NDIM(arrayin), PyArray_TYPE(arrayin));
    m = PyArray_DIM(arrayin,0);
    n = PyArray_DIM(arrayin,1);

    c = getptr_to_pyarray_double(arrayin);
    for (int i=0; i<m*n; i++)
        c[i] += inc;
}
## src/

　/w{PyArrayObject}型の/v{arrayin}を/w{double}型ポインタ配列に変換したものが/v{c}。
　これの各要素に/v{inc}を足す。

#---------------------------------------------------------------
/idx1{/wr{Python}からの呼び出し用のラッパー}
#---------------------------------------------------------------
## src c
static PyObject* py_inc_array(PyObject* self, PyObject* args) {
    PyObject *obj = NULL;
    double inc = 0.0;
    if (!PyArg_ParseTuple(args, "Od", &obj, &inc))
        return NULL;

    PyArrayObject *arr = (PyArrayObject *)PyArray_FROM_OTF(obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);
    if (arr == NULL)
        return NULL;

    inc_array(arr, inc);
    Py_DECREF(arr);
    Py_RETURN_NONE;
}
## src/

/b{PyObject PyArray_FROM_OTF(PyObject *obj, int typenum, int requirements)}
　/vr{obj}を/w{ndarray}に変換する関数。その機能は/v{PyArray_FROM_O}で提供されているが、そこに型の指定などの機能が加わったのがこの関数とのこと。
　参照:
　　+ /ac{Array API &#8212; NumPy v2.5 Manual - PyArray_FROM_OTF}{https://numpy.org/doc/stable/reference/c-api/array.html#c.PyArray_FROM_OTF}
　　+ /ac{Array API &#8212; NumPy v2.5 Manual - PyArray_FROM_O}{https://numpy.org/doc/stable/reference/c-api/array.html#c.PyArray_FROM_O}

/b{Py_DECREF(PyObject *obj)}
　メモリ開放をする手続き。
　自身が他のいくつの変数から参照されているかを確認して、それがゼロならメモリを解放する、というものらしい。
　参照:
　　+ /ac{Pythonのオブジェクトへの参照とガベージコレクション #ポエム - Qiita}{https://qiita.com/KMim/items/1c9e162f28309842669e}
　　+ /ac{参照カウント &#8212; Python 3.10.22 ドキュメント}{https://docs.python.org/ja/3.10/c-api/refcounting.html#c.Py_DECREF}

#---------------------------------------------------------------
/idx1{/wr{Python}から呼び出す}
#---------------------------------------------------------------
　最初の例で示したように、配列/v{a}の各要素に/w{1.1}が足されており、/w{C}側での/v{a}に対する操作が/w{Python}側にそのまま反映されていることが確認できる。
## src python
a = np.arange(20.).reshape(4,5)
c_module.inc_array(a, 1.1)
print(a)
## src/
## src plaintext
from inc_array
dimensions: 2, type: 12
[[ 1.1  2.1  3.1  4.1  5.1]
 [ 6.1  7.1  8.1  9.1 10.1]
 [11.1 12.1 13.1 14.1 15.1]
 [16.1 17.1 18.1 19.1 20.1]]
