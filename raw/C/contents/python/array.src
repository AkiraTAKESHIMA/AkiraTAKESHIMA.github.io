/idx1{コンパイル}
#---------------------------------------------------------------
## src plaintext
$ gcc -fPIC -Wall -c func.c -I/usr/include/python3.9
$ gcc -fPIC -Wall -c wrap.c -I/usr/include/python3.9
$ gcc -fPIC -Wall -shared -o c_module.so *.o
