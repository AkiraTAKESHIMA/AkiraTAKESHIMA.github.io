## index
純粋手続き (純粋関数、純粋サブルーチン)
## index/
## contents
　次のような手続きを純粋手続きという。
　　・標準入出力やファイルの入出力を行わない
　　・関数の場合は引数と返値、サブルーチンの場合は引数にのみ作用し、他の変数 (モジュール変数など) に影響を与えない

　純粋手続き内で呼び出す手続きは純粋手続きでなければならない。

　純粋手続きを定義するには、純粋手続きであることを明示的に示す必要がある。言い換えると、純粋手続きであることが明示されていない手続きは「純粋手続きでない手続き」として認識される。

　純粋手続きは/s{pure}というキーワードで定義する。

　組み込み手続きは全て純粋手続きである。

　純粋関数は変数の型の定義に用いることができる。純粋関数でない関数は用いることができない。

　例:
## src fortran
program main
  implicit none
  integer :: a, b

  a = 2
  b = 6

  print*, purefunc1(a, b)

contains
!===============================================================
!
!===============================================================
integer pure function purefunc1(a, b) result(c)
  implicit none
  integer, intent(in) :: a, b

  c = a * b

  c = purefunc2(c)

  call puresub1(a, b, c)
end function purefunc1
!===============================================================
!
!===============================================================
integer pure function purefunc2(c) result(x)
  implicit none
  integer, intent(in) :: c

  x = c + 1
end function purefunc2
!===============================================================
!
!===============================================================
pure subroutine puresub1(a, b, c)
  implicit none
  integer, intent(in) :: a, b
  integer, intent(inout) :: c

  if( a < 0 .or. b < 0 ) c = 0
end subroutine puresub1
!===============================================================
!
!===============================================================
end program main
