 i:          12 , array(i):           1
 i:          13 , array(i):           2
 i:          14 , array(i):           3
 i:          15 , array(i):           4
 i:          16 , array(i):           5
 i:          17 , array(i):           6
 i:          18 , array(i):           7
 i:          19 , array(i):           8
 i:          20 , array(i):           9
